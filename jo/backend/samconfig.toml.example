version = 0.1

[default]
[default.global.parameters]
stack_name = "campus-club-portal"

[default.build.parameters]
cached = true
parallel = true

[default.deploy.parameters]
capabilities = "CAPABILITY_IAM CAPABILITY_AUTO_EXPAND"
confirm_changeset = true
resolve_s3 = true
s3_prefix = "campus-club-portal"
region = "us-east-1"
image_repositories = []
